{
  "name": "kronova",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "worker:dev": "node scripts/run-local-worker.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --experimental-strip-types --test tests/*.test.mjs tests/unit/*.test.mjs tests/integration/*.test.mjs",
    "test:unit": "node --experimental-strip-types --test tests/*.test.mjs tests/unit/*.test.mjs",
    "test:integration": "node --experimental-strip-types --test tests/integration/*.test.mjs",
    "test:e2e": "playwright test",
    "test:smoke": "node scripts/smoke-deployment.mjs",
    "test:load": "node scripts/load-smoke.mjs",
    "validate:stripe-live": "node scripts/validate-stripe-live.mjs",
    "test:ci": "npm run typecheck && npm run lint && npm run test && npm run build && npm run test:e2e",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run build",
    "stripe:sync-products": "node scripts/stripe-sync-products.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@google/genai": "^2.15.0",
    "@stripe/stripe-js": "^9.12.1",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.111.0",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fast-xml-parser": "^5.10.1",
    "framer-motion": "^12.43.0",
    "lucide-react": "^1.28.0",
    "motion": "^12.43.0",
    "next": "16.2.12",
    "pdfjs-dist": "^6.1.200",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "stripe": "^22.4.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
