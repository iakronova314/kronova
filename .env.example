# Gemini (required for the current analysis preview)
APP_ENV=development
GEMINI_API_KEY=
CRON_SECRET=
ALERT_EMAIL_ENABLED=false
RESEND_API_KEY=
ALERT_EMAIL_FROM=KRONOVA <alerts@example.com>
GOOGLE_BUSINESS_CLIENT_ID=
GOOGLE_BUSINESS_CLIENT_SECRET=
# Base64-encoded 32-byte AES key. Keep separate per environment and rotate through a controlled migration.
REVIEWSYNC_TOKEN_ENCRYPTION_KEY=

# Supabase (reserved for the SaaS foundation tasks)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
# Recommended for new projects; the legacy anon key below is also supported.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (reserved for billing tasks)
STRIPE_BILLING_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PORTAL_CONFIGURATION_ID=
# One-off catalog script safety switch; never needed for normal app operation.
STRIPE_ALLOW_LIVE_SYNC=false

# Legal identity: required before production launch.
NEXT_PUBLIC_LEGAL_ENTITY=
NEXT_PUBLIC_LEGAL_EMAIL=
NEXT_PUBLIC_PRIVACY_EMAIL=
